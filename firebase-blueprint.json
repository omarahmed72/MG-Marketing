{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "User account registration and specialty assignment schema",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "status": { "type": "string", "enum": ["active", "pending"] },
        "specialty": { "type": "string" },
        "workload": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "overallRating": { "type": "number" }
      },
      "required": ["id", "name", "email", "role", "status", "specialty"]
    },
    "task": {
      "title": "Task",
      "description": "Work task assigned by the manager to a specific member with timer and weights",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "assigneeId": { "type": "string" },
        "campaignId": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "status": { "type": "string", "enum": ["todo", "progress", "review", "done", "rejected"] },
        "dueDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "timerDuration": { "type": "number" },
        "timerRemaining": { "type": "number" },
        "timerIsRunning": { "type": "boolean" },
        "timerStartedAt": { "type": "string" },
        "weight": { "type": "number" },
        "starsRating": { "type": "number" },
        "evaluatedAt": { "type": "string" }
      },
      "required": ["id", "title", "assigneeId", "campaignId", "priority", "status", "dueDate", "createdAt", "timerDuration", "timerRemaining", "timerIsRunning", "weight"]
    },
    "report": {
      "title": "TaskReport",
      "description": "Task completion report submitted by an employee for review by the admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "taskId": { "type": "string" },
        "taskTitle": { "type": "string" },
        "memberId": { "type": "string" },
        "memberName": { "type": "string" },
        "summary": { "type": "string" },
        "attachments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "adminFeedback": { "type": "string" },
        "starsAwarded": { "type": "number" },
        "reviewedAt": { "type": "string" },
        "rejectionExplanation": { "type": "string" },
        "rejectionAttachments": { "type": "array" },
        "rejectionCommentedAt": { "type": "string" }
      },
      "required": ["id", "taskId", "taskTitle", "memberId", "memberName", "summary", "createdAt", "status"]
    },
    "campaign": {
      "title": "Campaign",
      "description": "Marketing campaign details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "channel": { "type": "string" },
        "budget": { "type": "number" },
        "spent": { "type": "number" },
        "progress": { "type": "number" },
        "leads": { "type": "number" }
      },
      "required": ["id", "name", "channel", "budget", "spent", "progress", "leads"]
    },
    "specialty": {
      "title": "Specialty",
      "description": "Team professional specialties template list",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "description"]
    },
    "notification": {
      "title": "Notification",
      "description": "Instant notification alert for members and admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["tasks", "team", "review", "rating"] },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "title", "message", "type", "read", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "user",
      "description": "User profiles collection"
    },
    "tasks": {
      "schema": "task",
      "description": "Tasks distribution with timer and statuses"
    },
    "reports": {
      "schema": "report",
      "description": "Employees self-completed reports and admin review workflows"
    },
    "campaigns": {
      "schema": "campaign",
      "description": "Marketing campaigns tracking"
    },
    "specialties": {
      "schema": "specialty",
      "description": "List of specialized departments"
    },
    "notifications": {
      "schema": "notification",
      "description": "System alerts to recipients"
    }
  }
}
